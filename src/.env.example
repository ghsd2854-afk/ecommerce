APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=shop
DB_USERNAME=shop
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
#QUEUE_CONNECTION=database
QUEUE_CONNECTION=rabbitmq

CACHE_STORE=database


MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="Shop"


JWT_SECRET=
JWT_ALGO=HS256


INVENTORY_GRPC_HOST=inventory:50051
INVENTORY_GRPC_TIMEOUT_MS=2000

SIMULATE_ORDER_SAVE_FAILURE=false

#3
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379

CACHE_TTL_PRODUCT_LIST=60
CACHE_TTL_PRODUCT=300
CACHE_TTL_CATEGORIES=600
CACHE_TTL_SALES_REPORT=60

API_RATE_LIMIT=60

#  4:
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=shop
RABBITMQ_PASSWORD=secret
RABBITMQ_VHOST=/
RABBITMQ_QUEUE=shop.events
RABBITMQ_DLX=shop.dlx


SIMULATE_MAIL_FAILURE=false


BROADCAST_CONNECTION=reverb
REVERB_APP_ID=shop-app
REVERB_APP_KEY=shop-local-key
REVERB_APP_SECRET=shop-local-secret
REVERB_HOST=reverb
REVERB_PORT=6001
REVERB_SCHEME=http
